GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Email of the account that should be granted the Admin role on sign-up.
# Matched case-insensitively. Leave blank to disable the bootstrap.
ADMIN_EMAIL=""

# Cloudflare Stream — video Lesson upload + processing (Story 2.4, AD-5).
# All three must be set for video upload to be available; leave blank to
# cleanly disable it (the lesson editor still renders, uploads return 503).
# CLOUDFLARE_STREAM_API_TOKEN needs the Stream:Edit permission.
# CLOUDFLARE_STREAM_WEBHOOK_SECRET is the `secret` returned by
#   PUT /accounts/{id}/stream/webhook  {"notificationUrl": "<deploy>/api/webhooks/cloudflare-stream"}
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_STREAM_API_TOKEN=""
CLOUDFLARE_STREAM_WEBHOOK_SECRET=""
