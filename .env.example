DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"

RESEND_API_KEY=""
EMAIL_FROM="Sanabel <onboarding@resend.dev>"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Email of the account that should be granted the Admin role on sign-up.
# Matched case-insensitively. Leave blank to disable the bootstrap.
ADMIN_EMAIL=""

# Cloudflare Stream — video Lesson upload + processing (Story 2.4, AD-5).
# All three must be set for video upload to be available; leave blank to
# cleanly disable it (the lesson editor still renders, uploads return 503).
# CLOUDFLARE_STREAM_API_TOKEN needs the Stream:Edit permission.
# CLOUDFLARE_STREAM_WEBHOOK_SECRET is the `secret` returned by
#   PUT /accounts/{id}/stream/webhook  {"notificationUrl": "<deploy>/api/webhooks/cloudflare-stream"}
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_STREAM_API_TOKEN=""
CLOUDFLARE_STREAM_WEBHOOK_SECRET=""

# Cloudflare R2 — PDF Lesson storage (Story 2.6, AD-5). Reuses CLOUDFLARE_ACCOUNT_ID
# above. All three must be set for PDF upload to be available; leave blank to
# cleanly disable it. These are S3-compatible R2 credentials (R2 → Manage API
# tokens → Object Read & Write, scoped to this one bucket), NOT the Stream token.
# The bucket must stay private (no r2.dev URL, no custom domain) and needs a CORS
# rule allowing PUT from the app origin(s) with `Content-Type` allowed and `ETag`
# exposed — browser uploads fail without it.
# Vercel preview deploys have changing origins: add each one to the CORS policy or PDF
# uploads are only testable on localhost and production.
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
